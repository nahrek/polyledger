HYPERSYNC_BEARER_TOKEN=

# Storage
POLYLEDGER_DB=data/polyledger.duckdb
POLYLEDGER_EXPORT_DIR=data/parquet

# Indexing
POLYLEDGER_CONTRACTS=v2       # v2 | v1 | all
POLYLEDGER_FROM_BLOCK=0       # 0 = auto-detect the first fill
POLYLEDGER_REORG_BUFFER=64
POLYLEDGER_FLUSH_EVERY=50000

# REST politeness (CLOB + Gamma)
POLYLEDGER_HTTP_RPS=8
POLYLEDGER_HTTP_CONCURRENCY=8
POLYLEDGER_HTTP_RETRIES=6
POLYLEDGER_HTTP_TIMEOUT=30
